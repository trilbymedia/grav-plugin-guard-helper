{
    "name": "trilbymedia/grav-plugin-guard-helper",
    "type": "grav-plugin",
    "description": "Optional companion plugin for Grav Guard — in-admin checker, agent bootstrap, SSO, Shield hooks",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\GuardHelper\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grav\\Plugin\\GuardHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
