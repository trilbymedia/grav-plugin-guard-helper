{
    "name": "trilbymedia/grav-plugin-guard-helper",
    "type": "grav-plugin",
    "description": "Optional companion plugin for Grav Guard — agent setup from the browser, free vulnerability check, scheduler webhook",
    "license": "MIT",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\GuardHelper\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grav\\Plugin\\GuardHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
